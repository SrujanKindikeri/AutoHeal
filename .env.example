# MovieFlow Root Environment Configuration
COMPOSE_PROJECT_NAME=movieflow

# PostgreSQL
POSTGRES_DB=movieflow_db
POSTGRES_USER=movieflow_user
POSTGRES_PASSWORD=movieflow_secure_pass_2025
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=movieflow-super-secret-key-change-in-production
DEBUG=True

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# TMDB API (Phase 5 — Movie & TV Discovery)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
