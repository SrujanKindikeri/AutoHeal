# MovieFlow Backend Environment Configuration

DEBUG=True
SECRET_KEY=movieflow-insecure-development-key-change-in-production-apple-quality-2025
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:6060
CORS_ALLOWED_ORIGINS=http://localhost:6060,http://127.0.0.1:6060

# Database Configuration (PostgreSQL in Docker / SQLite in local sandbox fallback)
DATABASE_URL=postgresql://movieflow_user:movieflow_pass@localhost:5432/movieflow_db
DB_NAME=movieflow_db
DB_USER=movieflow_user
DB_PASSWORD=movieflow_pass
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (For Channels and Caching)
REDIS_URL=redis://localhost:6379/0

# TMDB API (Phase 5 — Movie & TV Discovery)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=lifeflow4u.support@gmail.com
EMAIL_HOST_PASSWORD=iilt hwlu nxzm mpyq
DEFAULT_FROM_EMAIL=MovieFlow <lifeflow4u.support@gmail.com>

# Security
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# MusicBrainz / Cover Art Archive (Phase 6 — Music Discovery)
# No API key required. MusicBrainz is a free, open music metadata database.
# The User-Agent is set automatically in settings.py.
# MUSICBRAINZ_USER_AGENT is configured in settings.py as 'MovieFlow/6.0 (movieflow@example.com)'
# Update this if you deploy under a different domain/contact.
MUSICBRAINZ_CONTACT_EMAIL=movieflow@example.com
